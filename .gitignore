# ==========================================
# MANORAKSHA — Git Ignore
# ==========================================

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example
!.env.production.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node / React / Vite ----------
node_modules/
dist/
build/
coverage/
.vite/

# ---------- Vercel ----------
.vercel/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Operating System ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- Local databases ----------
*.sqlite
*.sqlite3
*.db

# ---------- Temporary files ----------
tmp/
temp/
.cache/

# ---------- Local uploads ----------
uploads/
storage/

# ---------- Generated files ----------
*.generated.*
*.local.*

# ---------- Python distribution ----------
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- Test / coverage ----------
htmlcov/
.tox/
.nox/

# ---------- Secrets / certificates ----------
*.pem
*.key
*.crt

# ---------- OS/editor backup ----------
*~
*.bak
*.tmp
