# ==========================================
# MANORAKSHA — Environment Configuration
# ==========================================
#
# IMPORTANT:
# Copy this file to .env for local development.
#
# NEVER put real secrets in GitHub.
# NEVER put backend secrets inside frontend VITE_ variables.
# ==========================================


# =========================================================
# BACKEND
# =========================================================

APP_ENV=development


# ---------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------

SUPABASE_URL=

# Safe/public Supabase key
SUPABASE_PUBLISHABLE_KEY=

# SECRET — backend only
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------

DATABASE_URL=


# ---------------------------------------------------------
# REDIS
# ---------------------------------------------------------

# Optional for future caching / queues
REDIS_URL=


# =========================================================
# AI
# =========================================================

# OpenAI API key
# NEVER expose this in frontend code.
OPENAI_API_KEY=

AI_PROVIDER=openai

# Current model used by the backend.
# Keep this synchronized with backend/app/chat.py
AI_MODEL=gpt-5.6-luna


# =========================================================
# APPLICATION SECURITY
# =========================================================

# Generate a long random secret for production.
# Example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET=


# =========================================================
# FRONTEND
# =========================================================
#
# ONLY variables beginning with VITE_ are exposed to
# browser-side JavaScript.
#
# NEVER put:
# OPENAI_API_KEY
# SUPABASE_SECRET_KEY
# DATABASE_URL
# JWT_SECRET
#
# in VITE_ variables.
# =========================================================


# FastAPI / Render URL
VITE_API_BASE_URL=https://manoraksha-1.onrender.com


# Supabase public project information
VITE_SUPABASE_URL=

VITE_SUPABASE_PUBLISHABLE_KEY=


# =========================================================
# OPTIONAL FRONTEND SETTINGS
# =========================================================

# Application name
VITE_APP_NAME=MANORAKSHA

# Application version
VITE_APP_VERSION=2.1.0
# =========================================================
# TELEGRAM BOT (V14)
# =========================================================

# Create the bot with Telegram @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME_WITHOUT_@

# Long random value used to protect the webhook endpoint.
TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

