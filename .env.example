# ==========================================
# MANORAKSHA — Environment Configuration
# ==========================================
#
# IMPORTANT:
# Copy this file to .env for local development.
#
# NEVER put real secrets in GitHub.
# NEVER put backend secrets inside frontend VITE_ variables.
# ==========================================


# =========================================================
# BACKEND
# =========================================================

APP_ENV=development


# ---------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------

SUPABASE_URL=

# Safe/public Supabase key
SUPABASE_PUBLISHABLE_KEY=

# SECRET — backend only
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------

DATABASE_URL=


# ---------------------------------------------------------
# REDIS
# ---------------------------------------------------------

# Optional for future caching / queues
REDIS_URL=


# =========================================================
# AI
# =========================================================

# Gemini API key
# NEVER expose this in frontend code.
GEMINI_API_KEY=

AI_PROVIDER=gemini

# Current model used by the backend.
# Keep this synchronized with backend/app/chat.py
GEMINI_MODEL=gemini-2.5-flash-lite


# =========================================================
# APPLICATION SECURITY
# =========================================================

# Generate a long random secret for production.
# Example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET=


# =========================================================
# FRONTEND
# =========================================================
#
# ONLY variables beginning with VITE_ are exposed to
# browser-side JavaScript.
#
# NEVER put:
# GEMINI_API_KEY
# SUPABASE_SECRET_KEY
# DATABASE_URL
# JWT_SECRET
#
# in VITE_ variables.
# =========================================================


# FastAPI / Render URL
VITE_API_BASE_URL=https://manoraksha-1.onrender.com


# Supabase public project information
VITE_SUPABASE_URL=

VITE_SUPABASE_PUBLISHABLE_KEY=


# =========================================================
# OPTIONAL FRONTEND SETTINGS
# =========================================================

# Application name
VITE_APP_NAME=MANORAKSHA

# Application version
VITE_APP_VERSION=2.0.0
